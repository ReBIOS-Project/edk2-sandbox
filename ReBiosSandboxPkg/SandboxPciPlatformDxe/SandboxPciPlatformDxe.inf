[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = SandboxPciPlatformDxe
  FILE_GUID      = 03F2AF4B-05CD-4F71-93C6-7BC25C655753
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = SandboxPciPlatformDxeEntry

[Sources]
  SandboxPciPlatformDxe.c

[Packages]
  MdePkg/MdePkg.dec
  ReBiosSandboxPkg/ReBiosSandboxPkg.dec

[LibraryClasses]
  DebugLib
  HobLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gReBiosSandboxHandoffHobGuid   ## CONSUMES

[Protocols]
  gEfiPciIoProtocolGuid          ## CONSUMES
  gEfiPciPlatformProtocolGuid    ## PRODUCES

[Depex]
  TRUE
