[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = SandboxPcdDxe
  FILE_GUID      = 9762F2E1-3CA0-4F60-9C2B-003AF4174D60
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = SandboxPcdDxeEntry

[Sources]
  SandboxPcdDxe.c

[Packages]
  MdePkg/MdePkg.dec
  ReBiosSandboxPkg/ReBiosSandboxPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  HobLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Guids]
  gReBiosSandboxHandoffHobGuid   ## CONSUMES

[Protocols]
  gPcdProtocolGuid               ## PRODUCES
  gEfiPcdProtocolGuid            ## PRODUCES
  gGetPcdInfoProtocolGuid        ## PRODUCES
  gEfiGetPcdInfoProtocolGuid     ## PRODUCES

[Depex]
  TRUE
